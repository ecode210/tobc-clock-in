# Postgres connection (docker compose up -d db at the repo root exposes it on 5433)
DATABASE_URL=postgres://clockin:clockin@localhost:5433/clockin

# Secret used to sign the admin session cookie (JWT, 12h). Use a long random value, e.g. `openssl rand -hex 32`.
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Shared bearer token the church laptop uses for /api/sync/* (must match the Go server's --sync-token / SYNC_TOKEN)
SYNC_TOKEN=dev-sync-token

# Optional: IANA time zone used for "today" defaults and display (defaults to the server's zone)
# APP_TIMEZONE=Europe/London
